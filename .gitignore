# Editor local history
.history/

# KiCad lock / autosave / backup
*.lck
~*
*-backups/
_restore_backup_*
*.bak
fp-info-cache

# KiCad per-user local state
*.kicad_prl

# Autorouter round-trip intermediates
*.dsn
*.ses

# Reports (regenerated by kicad-cli)
*.rpt
net.net

# Third-party library: keep only the one footprint set this board uses.
# Full library: https://github.com/kiswitch/kiswitch
libs/**
!libs/kiswitch-main/
!libs/kiswitch-main/LICENSE-CC-BY-SA
!libs/kiswitch-main/LICENSE-MIT
!libs/kiswitch-main/library/
!libs/kiswitch-main/library/footprints/
!libs/kiswitch-main/library/footprints/Switch_Keyboard_Hotswap_Kailh.pretty/
!libs/kiswitch-main/library/footprints/Switch_Keyboard_Hotswap_Kailh.pretty/**
